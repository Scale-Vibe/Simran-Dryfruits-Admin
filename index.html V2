    <div class="wrow">${WTS.map(w=>{const off=(p.stockW||{})[w]===false;return `<button class="wbtn ${off?'out':'ok'}" data-a="wt" data-id="${esc(p.id)}" data-g="${w}">${wl(w)} ${off?'out':'in'}</button>`}).join('')}</div>
