    ${(p.fixedQty===true||String(p.fixedQty).toUpperCase()==='TRUE')?`<div class="field" style="margin-top:4px"><span>Fixed weight</span><select data-c="fixedWeight" data-id="${esc(p.id)}"><option value="50" ${p.fixedWeight==50?'selected':''}>50g</option><option value="100" ${p.fixedWeight==100?'selected':''}>100g</option><option value="125" ${p.fixedWeight==125?'selected':''}>125g</option><option value="250" ${p.fixedWeight==250?'selected':''}>250g</option><option value="500" ${p.fixedWeight==500?'selected':''}>500g</option><option value="1000" ${p.fixedWeight==1000?'selected':''}>1 kg</option></select></div>`:''}
