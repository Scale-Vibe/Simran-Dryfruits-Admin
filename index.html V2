<!DOCTYPE html>
<html lang="en" translate="no">
<head>
<meta charset="utf-8">
<meta name="google" content="notranslate">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover">
<title>SIMRAN Owner Portal</title>
<meta name="theme-color" content="#5A2D16">
<meta name="application-name" content="Simran Admin">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Simran Admin">
<link rel="manifest" href="./manifest.json">
<link rel="apple-touch-icon" href="./simranadmin.png">
<link rel="manifest" href="data:application/manifest+json,{%22name%22:%22Simran%20Admin%20Portal%22,%22short_name%22:%22SimranAdmin%22,%22start_url%22:%22.%22,%22display%22:%22standalone%22,%22background_color%22:%22%23F7F4EE%22,%22theme_color%22:%22%235A2D16%22,%22icons%22:[{%22src%22:%22https://imgh.in/host/tzyar2%22,%22sizes%22:%22192x192%22,%22type%22:%22image/png%22}]}">
<link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{--b:#5A2D16;--g:#2F5D3A;--m:#C58A1B;--bg:#F7F4EE;--card:#FFFFFF;--line:#ECE6D9;--ink:#221a12;--mut:#7d7060;--red:#b3362e;--ok:#2e9e4f;--soft:#faf7f1}
html.dark{--bg:#0E0F0C;--card:#171A15;--line:#262B23;--ink:#F3EEE4;--mut:#9b927f;--soft:#1d211a;--b:#E6C58A;--g:#7FB58F}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{margin:0}
body{font-family:"Plus Jakarta Sans",system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--bg);color:var(--ink);min-height:100vh;padding-bottom:92px;transition:background .3s}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none;padding:0}
button:disabled{opacity:.45;cursor:not-allowed}
main{max-width:760px;margin:0 auto;padding:18px 16px}
h1,h2,h3{margin:0;font-weight:900;color:var(--ink)}
.kicker{font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--mut)}
/* header */
.top{position:sticky;top:0;z-index:30;background:var(--card);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:12px 16px;gap:10px}
.logo-text{font-size:20px;font-weight:900;color:var(--b);letter-spacing:-.02em}
.tools{display:flex;align-items:center;gap:8px}
.ibtn{width:40px;height:40px;border-radius:999px;background:var(--card);border:1px solid var(--line);display:grid;place-items:center;font-size:18px}
.ibtn.spin i{animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.live{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:800;color:var(--mut);padding:0 6px}
.live i{width:8px;height:8px;border-radius:50%;background:#9b927f}
.live.ok i{background:var(--ok);animation:pulse 2s infinite}
.live.err i{background:var(--red)}
@keyframes pulse{0%{box-shadow:0 0 0 0 #2e9e4f80}70%{box-shadow:0 0 0 7px #2e9e4f00}100%{box-shadow:0 0 0 0 #2e9e4f00}}
/* setup banner */
.setup{margin:14px 0 0;padding:14px;border-radius:16px;background:#fff7e6;border:1px solid #efd9a6;color:#6b4a0f;font-weight:700;font-size:14px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
/* pages */
.ph-head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin:8px 0 16px}
.ph-head h2{font-size:26px;letter-spacing:-.02em}
.ph-head p{margin:4px 0 0;font-size:13px;color:var(--mut);font-weight:600}
.card{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:18px;box-shadow:0 1px 2px #0000000d}
.stack{display:flex;flex-direction:column;gap:12px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.grid4{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
@media(min-width:620px){.grid4{grid-template-columns:repeat(4,1fr)}}
.hero{background:var(--b);color:#fff;border-radius:28px;padding:22px;position:relative;overflow:hidden;margin-bottom:16px}
html.dark .hero{color:#171A15}
.hero i.bg{position:absolute;right:-14px;top:-14px;font-size:120px;opacity:.08}
.hero b.amt{display:block;font:900 38px "Plus Jakarta Sans",sans-serif;letter-spacing:-.02em;margin-top:4px}
.hero .row{display:flex;gap:10px;margin-top:16px;position:relative;z-index:1;flex-wrap:wrap}
.stat{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:16px}
.stat small{font-size:12px;font-weight:800;color:var(--mut)}
.stat b{display:block;font-size:24px;font-weight:900;margin-top:4px;letter-spacing:-.02em}
.stat.warn{border-color:#f0c9c5}
.stat.warn b{color:var(--red)}
.section-h{display:flex;justify-content:space-between;align-items:center;margin:22px 4px 10px}
.section-h h3{font-size:18px}
.section-h button{font-size:13px;font-weight:800;color:var(--m)}
.notice{padding:12px 14px;border-radius:16px;font-size:14px;font-weight:700;display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.notice.warn{background:#fff3f1;color:#8a2a22;border:1px solid #f0c9c5}
.notice.info{background:#eef6f0;color:var(--g);border:1px solid #cfe5d5}
html.dark .notice.warn{background:#2a1714;color:#f2b8b1;border-color:#4a2420}
html.dark .notice.info{background:#14201a;color:#9fd1ab;border-color:#24382b}
/* buttons */
.btn{min-height:46px;padding:0 18px;border-radius:14px;background:var(--g);color:#fff;font-weight:800;font-size:15px;display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid var(--g);text-decoration:none;transition:transform .1s}
.btn:active{transform:scale(.98)}
html.dark .btn{color:#0E0F0C}
.btn.ghost{background:var(--card);color:var(--g)}
.btn.warn{background:var(--card);color:var(--red);border-color:#e7b4af}
.btn.wa{background:#25a25a;border-color:#25a25a;color:#fff}
.btn.sm{min-height:38px;font-size:13.5px;padding:0 14px;border-radius:12px}
.btn.full{width:100%}
.link{color:var(--red);font-size:13.5px;font-weight:800;padding:8px 4px}
.seg{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px;margin-bottom:14px}
.seg button{flex:none;min-height:40px;padding:0 16px;border-radius:999px;border:1px solid var(--line);background:var(--card);font-weight:800;font-size:14px;white-space:nowrap}
.seg button.on{background:var(--g);border-color:var(--g);color:#fff}
html.dark .seg button.on{color:#0E0F0C}
.seg b{margin-left:6px;opacity:.7}
/* forms */
.field{display:block;margin-top:14px}
.field>span{display:block;font-size:12px;font-weight:800;color:var(--mut);margin-bottom:6px;letter-spacing:.02em}
input,select,textarea{width:100%;padding:13px 14px;border:1px solid var(--line);border-radius:14px;background:var(--soft);outline:none}
input:focus,select:focus,textarea:focus{border-color:var(--g)}
.chk{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
.chk label{display:inline-flex;align-items:center;gap:8px;padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:var(--soft);font-size:14px;font-weight:700;cursor:pointer}
.chk input{width:auto;margin:0}
.switchrow{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 0}
.switchrow+.switchrow{border-top:1px solid var(--line)}
.switchrow small{display:block;color:var(--mut);font-size:12.5px;font-weight:600;margin-top:2px}
.sw{position:relative;display:inline-block;width:52px;height:30px;flex:none}
.sw input{opacity:0;width:0;height:0;position:absolute}
.sw span{position:absolute;inset:0;background:#cfc8b9;border-radius:999px;transition:.2s;cursor:pointer}
.sw span:before{content:"";position:absolute;width:24px;height:24px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s;box-shadow:0 1px 3px #0003}
.sw input:checked+span{background:var(--g)}
.sw input:checked+span:before{transform:translateX(22px)}
.preview{margin-top:12px;display:flex;gap:12px;align-items:center;padding:10px;border-radius:16px;background:var(--soft);border:1px dashed var(--line);min-height:84px}
.preview img,.preview video{width:110px;height:150px;object-fit:cover;border-radius:12px;background:#111}
.drop{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:22px;border:2px dashed var(--line);border-radius:18px;background:var(--soft);text-align:center;cursor:pointer;font-weight:700;color:var(--mut)}
.drop i{font-size:30px;color:var(--m)}
.drop input{display:none}
.hint{font-size:12.5px;color:var(--mut);font-weight:600;margin:6px 2px 0}
/* lists */
.item{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:14px}
.prod{display:flex;gap:12px;align-items:center;min-width:0}
.thumb{width:56px;height:56px;border-radius:14px;display:grid;place-items:center;font-size:28px;flex:none;object-fit:cover;overflow:hidden}
.thumb.vid{width:72px;height:88px;background:#111;color:#fff;font-size:22px}
img.thumb{display:block}
.name{font-weight:800;font-size:15.5px;line-height:1.25}
.sub{font-size:12.5px;color:var(--mut);font-weight:600;margin-top:2px}
.pill{display:inline-flex;align-items:center;font-size:11.5px;font-weight:800;padding:5px 10px;border-radius:999px;background:var(--soft);color:var(--mut);white-space:nowrap}
.pill.placed{background:#fff3d6;color:#7d4e0c}
.pill.confirmed{background:#e3eefb;color:#2a5a8a}
.pill.packed{background:#efe6fb;color:#5a3a8a}
.pill.ready{background:#dff3e5;color:#1f6e36}
.pill.collected{background:#dff3e5;color:#1f6e36}
.pill.cancelled{background:#fbe3e3;color:var(--red)}
.pill.off{background:#fbe3e3;color:var(--red)}
.pill.on{background:#dff3e5;color:#1f6e36}
.wrow{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.wbtn{min-height:38px;padding:0 13px;border-radius:12px;border:1px solid var(--line);background:var(--soft);font-weight:800;font-size:13.5px}
.wbtn.ok{background:#eef8f1;color:#1f6e36;border-color:#bfe3cb}
html.dark .wbtn.ok{background:#14201a;color:#9fd1ab;border-color:#24382b}
.wbtn.out{background:#fbe9e7;color:var(--red);border-color:#efc2bd;text-decoration:line-through}
html.dark .wbtn.out{background:#2a1714;border-color:#4a2420}
.order{background:var(--card);border:1px solid var(--line);border-left:6px solid var(--line);border-radius:22px;padding:16px}
.order.placed{border-left-color:var(--m)}
.order.confirmed{border-left-color:#3a78b5}
.order.packed{border-left-color:#7a4fb0}
.order.ready{border-left-color:var(--ok)}
.order.collected{opacity:.75}
.order.cancelled{border-left-color:var(--red);opacity:.6}
.o-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.o-code{font-weight:900;font-size:18px;letter-spacing:-.01em}
.prog{height:6px;border-radius:99px;background:var(--soft);overflow:hidden;margin:12px 0}
.prog i{display:block;height:100%;background:var(--g);border-radius:99px;transition:width .4s}
.cust{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px;background:var(--soft);border-radius:16px}
.cust b{font-size:15px}
.ibs{display:flex;gap:8px}
.ib{width:42px;height:42px;border-radius:13px;background:var(--card);border:1px solid var(--line);display:grid;place-items:center;font-size:19px;text-decoration:none;color:var(--ink)}
.ib.wa{color:#25a25a}
.lines{list-style:none;padding:0;margin:12px 0 0}
.lines li{display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px dashed var(--line);font-size:14.5px;font-weight:600}
.lines li:last-child{border:0}
.note{margin:10px 0 0;padding:10px 12px;border-radius:12px;background:#fbf6e9;color:#6b4a0f;font-size:13.5px;font-weight:700}
html.dark .note{background:#2a2412;color:#e6c58a}
.tot{display:flex;justify-content:space-between;align-items:center;margin-top:12px}
.tot b{font-size:20px;font-weight:900}
.acts{margin-top:14px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.acts .btn{flex:1;min-width:180px}
.empty{text-align:center;padding:40px 16px;color:var(--mut);font-weight:700;border:1px dashed var(--line);border-radius:20px}
.empty i{display:block;font-size:34px;color:var(--m);margin-bottom:6px}
/* bottom nav */
.nav{position:fixed;left:0;right:0;bottom:0;margin:0 auto;max-width:760px;background:var(--card);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(6,1fr);padding:6px 4px calc(6px + env(safe-area-inset-bottom));z-index:40}
.nav button{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-height:52px;font-size:11px;font-weight:800;color:var(--mut)}
.nav button i{font-size:21px}
.nav button.on{color:var(--g)}
html.dark .nav button.on{color:#7FB58F}
.nav .cnt{position:absolute;top:4px;left:calc(50% + 6px);background:var(--red);color:#fff;border-radius:999px;font-size:10px;min-width:18px;height:18px;line-height:18px;text-align:center;padding:0 5px}
/* toasts */
#toasts{position:fixed;top:78px;left:50%;transform:translateX(-50%);z-index:90;display:flex;flex-direction:column;gap:8px;width:92%;max-width:440px;pointer-events:none}
.toast{background:#221a12;color:#fff;padding:13px 16px;border-radius:16px;font-weight:700;font-size:14px;box-shadow:0 10px 28px #0005;display:flex;align-items:center;gap:10px;animation:up .25s ease;transition:opacity .3s}
html.dark .toast{background:#F3EEE4;color:#171A15}
.toast.error i{color:#ff8a80}
@keyframes up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
/* print */
#printArea{display:none}
@media print{body>*:not(#printArea){display:none!important}#printArea{display:block!important;font-family:monospace;font-size:13px;padding:16px;color:#000;background:#fff}}
</style>
</head>
<body>

<header class="top">
  <div style="display:flex;align-items:center;gap:10px">
    <img src="https://imgh.in/host/tzyar2" alt="Simran Dryfruits" style="height:40px;width:auto;border-radius:8px;object-fit:contain;flex:none">
    <span class="logo-text">SIMRAN</span>
  </div>
  <div class="tools">
    <span class="live" id="live"><i></i><span id="liveTxt">Connect</span></span>
    <button class="ibtn" data-a="theme" aria-label="Theme"><i id="themeIco" class="ri-moon-fill"></i></button>
    <button class="ibtn" id="syncBtn" data-a="sync" aria-label="Refresh"><i class="ri-refresh-line"></i></button>
  </div>
</header>

<main>
  <div class="setup" id="setupBar" hidden>
    <span>Pehle backend connect karein: More → Connect.</span>
    <button class="btn sm" data-a="nav" data-v="more" data-m="connect">Connect now</button>
  </div>

  <!-- HOME -->
  <section data-page="home">
    <div class="ph-head"><div><div class="kicker">Owner portal</div><h2>Overview</h2></div></div>
    <div class="hero">
      <i class="ri-wallet-3-fill bg"></i>
      <span class="kicker" style="color:inherit;opacity:.7">Today's sales</span>
      <b class="amt" id="hSales">₹0</b>
      <div class="row">
        <button class="btn ghost" style="background:#ffffff1f;color:inherit;border-color:transparent" data-a="nav" data-v="orders">Orders <span id="hNew"></span></button>
        <button class="btn ghost" style="background:#ffffff1f;color:inherit;border-color:transparent" data-a="nav" data-v="reels">Upload reel</button>
      </div>
    </div>
    <div class="grid4" id="hStats"></div>
    <div class="section-h"><h3>Recent orders</h3><button data-a="nav" data-v="orders">See all</button></div>
    <div class="stack" id="hRecent"></div>
  </section>

  <!-- ORDERS -->
  <section data-page="orders" hidden>
    <div class="ph-head"><div><div class="kicker">Takeaway</div><h2>Orders</h2><p>Naye orders turant dikhte hain. Har order ka status ek tap mein badlein.</p></div></div>
    <div class="seg" id="oFilters"></div>
    <input id="oq" type="search" placeholder="Search order code or phone" style="margin-bottom:14px">
    <div class="stack" id="oList"></div>
  </section>

  <!-- STOCK -->
  <section data-page="stock" hidden>
    <div class="ph-head"><div><div class="kicker">Availability</div><h2>Stock</h2><p>Badlaav turant customer page par dikhenge.</p></div></div>
    <div id="sSummary"></div>
    <div class="stack" id="sList"></div>
  </section>

  <!-- PRICES -->
  <section data-page="prices" hidden>
    <div class="ph-head"><div><div class="kicker">Rates</div><h2>Prices</h2><p>Rate per kg aur har weight ka alag price.</p></div></div>
    <div class="card">
      <h3 style="font-size:16px">Sab rates ek saath badlein</h3>
      <div class="grid2" style="margin-top:12px">
        <input id="bulkPct" type="number" inputmode="decimal" placeholder="Percent, e.g. 5">
        <div class="grid2" style="gap:8px">
          <button class="btn sm" data-a="bulk" data-d="1">+ Increase</button>
          <button class="btn sm ghost" data-a="bulk" data-d="-1">− Decrease</button>
        </div>
      </div>
    </div>
    <div class="stack" id="pList" style="margin-top:14px"></div>
    <div class="section-h"><h3>Price history</h3></div>
    <div class="card" id="pHist"></div>
  </section>

  <!-- REELS -->
  <section data-page="reels" hidden>
    <div class="ph-head"><div><div class="kicker">Marketing</div><h2>Reels & videos</h2><p>Video upload karein ya YouTube/Instagram ka link dein. Customer page ki "Watch & Add" strip mein dikhega.</p></div></div>
    <div class="card">
      <label class="drop" id="rDrop">
        <i class="ri-upload-cloud-2-line"></i>
        <span id="rDropTxt">Video chunein (MP4, MOV, WebM — max 100 MB)</span>
        <input id="rFile" type="file" accept="video/*">
      </label>
      <div class="preview" id="rPrev" hidden></div>
      <label class="field"><span>Ya link paste karein (YouTube Shorts / Instagram reel)</span>
        <input id="rLink" type="url" inputmode="url" placeholder="https://youtube.com/shorts/..."></label>
      <label class="field"><span>Title (English)</span><input id="rEn" placeholder="Pumpkin seeds: healthy and affordable"></label>
      <label class="field"><span>Title (हिंदी)</span><input id="rHi" placeholder="कद्दू के बीज: सेहतमंद"></label>
      <div class="grid2">
        <label class="field"><span>Linked product</span><select id="rPid"></select></label>
        <label class="field"><span>Weight</span>
          <select id="rW"><option value="50">50g</option><option value="100" selected>100g</option><option value="125">125g</option><option value="250">250g</option></select></label>
      </div>
      <div class="switchrow"><div>Customer page par dikhayein<small>Band karne par reel hide ho jayegi</small></div>
        <label class="sw"><input type="checkbox" id="rOn" checked><span></span></label></div>
      <div style="margin-top:16px"><button class="btn full" id="rBtn" data-a="rsave">Publish reel</button></div>
    </div>
    <div class="section-h"><h3>Live reels</h3></div>
    <div class="stack" id="rList"></div>
  </section>

  <!-- MORE -->
  <section data-page="more" hidden>
    <div class="ph-head"><div><div class="kicker">Settings</div><h2>More</h2></div></div>
    <div class="seg">
      <button data-a="mtab" data-v="products">Products</button>
      <button data-a="mtab" data-v="banners">Banners</button>
      <button data-a="mtab" data-v="shop">Shop</button>
      <button data-a="mtab" data-v="connect">Connect</button>
    </div>

    <div data-m="products">
      <div class="card">
        <h3 id="pfTitle" style="font-size:18px">Naya product</h3>
        <div class="grid2">
          <label class="field"><span>Name (English)</span><input id="pfEn"></label>
          <label class="field"><span>नाम (हिंदी)</span><input id="pfHi"></label>
        </div>
        <div class="grid2">
          <label class="field"><span>Emoji</span><input id="pfEmo" maxlength="4" placeholder="🥜"></label>
          <label class="field"><span>Rate per kg (₹)</span><input id="pfRate" type="number" inputmode="numeric"></label>
        </div>
        <label class="drop" style="margin-top:14px"><i class="ri-image-add-line"></i><span id="pfPhotoTxt">Photo upload karein (optional)</span><input id="pfPhotoFile" type="file" accept="image/*"></label>
        <label class="field"><span>Ya photo ka link</span><input id="pfPhoto" placeholder="https://..."></label>
        <div class="field"><span>Categories</span><div class="chk" id="pfCats"></div></div>
        <div class="field"><span>Tags</span>
          <div class="chk"><label><input type="checkbox" data-tag value="Bestseller"> Bestseller</label><label><input type="checkbox" data-tag value="New"> New</label></div></div>
        <div class="switchrow" style="margin-top:8px">
          <div>Fixed quantity only (ek hi weight milta hai)
            <small>ON karne par customer sirf ek weight choose kar sakta hai</small>
          </div>
          <label class="sw"><input type="checkbox" id="pfFixedQty"><span></span></label>
        </div>
        <div id="pfFixedWeightWrap" class="field" style="display:none">
          <span>Fixed weight</span>
