function clearPF(){
  editId=null;$('#pfTitle').textContent='Naya product';
  ['pfEn','pfHi','pfEmo','pfRate','pfPhoto'].forEach(i=>$('#'+i).value='');
  $('#pfPhotoTxt').textContent='Photo upload karein (optional)';
  $$('[data-cat],[data-tag]').forEach(i=>i.checked=false);
  $('#pfFixedQty').checked=false;$('#pfFixedWeightWrap').style.display='none';$('#pfFixedWeight').value='250';
}
function startEdit(id){
  const p=(D.products||[]).find(x=>x.id===id);if(!p)return;
  editId=id;$('#pfTitle').textContent='Edit: '+p.en;
  $('#pfEn').value=p.en;$('#pfHi').value=p.hi||'';$('#pfEmo').value=p.emoji||'';$('#pfRate').value=p.rate;$('#pfPhoto').value=p.photo||'';
  $$('[data-cat]').forEach(i=>i.checked=(p.cats||[]).includes(i.value));
  $$('[data-tag]').forEach(i=>i.checked=(p.tags||[]).includes(i.value));
  $('#pfFixedQty').checked=!!p.fixedQty;$('#pfFixedWeightWrap').style.display=p.fixedQty?'block':'none';if(p.fixedWeight)$('#pfFixedWeight').value=p.fixedWeight;
  window.scrollTo({top:0,behavior:'smooth'});
}
function saveProduct(){
  const en=$('#pfEn').value.trim(),rate=+$('#pfRate').value;
  if(!en)return toast('English name chahiye','error');
  if(!rate)return toast('Rate per kg daalein','error');
  const old=(D.products||[]).find(x=>x.id===editId)||{};
  const id=editId||'p'+Date.now();
  const item={...old,en,hi:$('#pfHi').value.trim()||en,emoji:$('#pfEmo').value.trim()||'🥜',photo:$('#pfPhoto').value.trim(),
    cats:$$('[data-cat]:checked').map(i=>i.value),tags:$$('[data-tag]:checked').map(i=>i.value),rate,
    bg:old.bg||'#f3ebd9',stock:old.stock!==false,hidden:!!old.hidden,stockW:old.stockW||{},overrides:old.overrides||{},
    fixedQty:$('#pfFixedQty').checked,fixedWeight:$('#pfFixedQty').checked?+$('#pfFixedWeight').value:null};
  upsert('products',id,item,'Product save ho gaya');
  clearPF();
}
async function seedSamples(){
  if(!connected())return toast('Pehle Connect karein','error');
  busy++;
  try{
    const r1=await apiPost({action:'bulk',table:'products',items:SEED_PRODUCTS.map(p=>({id:p.id,item:{...p,stock:true,hidden:false,stockW:{},overrides:{}}}))});
    const r2=await apiPost({action:'setShop',shop:SEED_SHOP});
    if(!r1.ok||!r2.ok)throw new Error(r1.error||r2.error||'failed');
    toast('Sample products load ho gaye');
  }catch(e){toast('Error: '+e.message,'error')}
  finally{busy--;lastKey='';poll(true)}
}

/* ===================== BANNERS ===================== */
function renderBanners(){
  const B=D.banners||[];
  $('#bList').innerHTML=B.length?B.map(b=>`<div class="item"><div class="name">${esc(b.en)}</div><div class="sub">${esc(b.hi||'')}</div>
    ${b.img?`<img src="${esc(cdn(b.img))}" alt="" style="width:100%;max-height:120px;object-fit:cover;border-radius:12px;margin-top:8px">`:''} 
    <div class="sub" style="margin-top:4px">${b.start||'Kisi bhi din se'} → ${b.end||'koi end date nahi'}</div>
    <div class="switchrow" style="margin-top:6px"><div>${b.on!==false?'<span class="pill on">Showing</span>':'<span class="pill off">Off</span>'}</div>
      <label class="sw"><input type="checkbox" data-c="bon" data-id="${esc(b.id)}" ${b.on!==false?'checked':''}><span></span></label></div>
    <div style="text-align:right"><button class="link" data-a="bdel" data-id="${esc(b.id)}">Delete</button></div></div>`).join(''):`<div class="empty"><i class="ri-flag-line"></i>Koi banner nahi. Customer page par tab tak kuch nahi dikhega.</div>`;
}
async function saveBanner(){
  const en=$('#bEn').value.trim();if(!en)return toast('Banner text chahiye','error');
  const btn=document.querySelector('[data-a="bsave"]');btn.disabled=true;
  try{
    let img=$('#bImg').value.trim();
    const f=$('#bImgFile').files[0];
    if(f){
      btn.textContent='Uploading…';
      const r=await uploadCloud(f,'image');
      img=r.url;
    }
    await upsert('banners','b'+Date.now(),{en,hi:$('#bHi').value.trim()||en,img,start:$('#bS').value,end:$('#bE').value,on:true},'Banner save ho gaya');
    $('#bEn').value='';$('#bHi').value='';$('#bImg').value='';$('#bImgFile').value='';$('#bImgTxt').textContent='Banner image upload karein (optional)';
  }catch(e){toast(e.message,'error')}
  finally{btn.disabled=false;btn.textContent='Save banner'}
}

/* ===================== SHOP & CONNECT ===================== */
function fillShop(){
  const p={...SEED_SHOP,...(D.shop||{})};
  $('#sOpen').checked=p.open!==false;$('#sO').value=p.openT||'10:00';$('#sC').value=p.closeT||'21:00';
  $('#sPrep').value=p.prep||30;$('#sSlot').value=p.slot||30;$('#sFssai').value=p.fssai||'';$('#sUpi').value=p.upi||'';
  $('#sPhone').value=p.phone||'';$('#sWa').value=p.wa||'';$('#sAddr').value=p.address||'';$('#sMap').value=p.map||'';
  $('#sFssaiImg').value=p.fssaiImg||'';
}
function saveShop(){
  const shop={...(D.shop||{}),open:$('#sOpen').checked,openT:$('#sO').value||'10:00',closeT:$('#sC').value||'21:00',
    prep:+$('#sPrep').value||30,slot:+$('#sSlot').value||30,fssai:$('#sFssai').value.trim(),upi:$('#sUpi').value.trim(),
    phone:$('#sPhone').value.replace(/\D/g,''),wa:$('#sWa').value.replace(/\D/g,''),address:$('#sAddr').value.trim(),map:$('#sMap').value.trim(),
    fssaiImg:$('#sFssaiImg').value.trim()};
  mutate({action:'setShop',shop},'Shop details save ho gaye');
}
function fillConnect(){const c=cfg();$('#cUrl').value=c.url;$('#cTok').value=c.token;$('#cCloud').value=c.cloud;$('#cPreset').value=c.preset}
async function saveConnect(){
  const url=$('#cUrl').value.trim(),token=$('#cTok').value.trim();
  if(!isUrl(url))return toast('Web app URL https://script.google.com/... se shuru hona chahiye','error');
  if(!token)return toast('Admin token daalein','error');
  save(CFG_KEY,{url,token,cloud:$('#cCloud').value.trim(),preset:$('#cPreset').value.trim()});
  try{
    const j=await apiGet({action:'all',token});
    if(!j.ok)throw new Error(j.error==='unauthorized'?'Token galat hai':j.error);
    toast('Connected! Data sync ho raha hai');
  }catch(e){toast('Connect nahi hua: '+e.message,'error')}
  lastKey='';poll(true);
}

/* ===================== EVENTS ===================== */
document.addEventListener('click',e=>{
  const el=e.target.closest('[data-a]');if(!el)return;
  const a=el.dataset.a;
  switch(a){
    case 'nav':nav(el.dataset.v,el.dataset.m);break;
    case 'mtab':showMtab(el.dataset.v);break;
    case 'theme':{const d=document.documentElement.classList.toggle('dark');save('sd_theme',d?'dark':'light');$('#themeIco').className=d?'ri-sun-fill':'ri-moon-fill';break}
    case 'sync':{const b=$('#syncBtn');b.classList.add('spin');lastKey='';poll(true).finally(()=>setTimeout(()=>b.classList.remove('spin'),400));break}
    case 'ofilter':ofilter=el.dataset.f;renderOrders();break;
    case 'ostatus':setOrderStatus(el.dataset.code,el.dataset.s);break;
    case 'print':printBill(el.dataset.code);break;
    case 'wt':{const p=(D.products||[]).find(x=>x.id===el.dataset.id);if(!p)break;const g=+el.dataset.g;const sw={...(p.stockW||{})};sw[g]=sw[g]===false;upsert('products',p.id,{...p,stockW:sw});break}
    case 'bulk':{const pct=+$('#bulkPct').value;if(!pct)return toast('Pehle percent daalein','error');
      const f=1+(+el.dataset.d)*pct/100,changed=[],hist=[];
      (D.products||[]).forEach(p=>{const to=Math.round(p.rate*f);if(to!==p.rate){changed.push({id:p.id,item:{...p,rate:to}});hist.push({name:p.en,from:p.rate,to})}});
      if(!changed.length)return toast('Koi rate nahi badla');
      busy++;
      apiPost({action:'bulk',table:'products',items:changed}).then(async()=>{for(const h of hist)await apiPost({action:'upsert',table:'history',id:'h'+Date.now()+Math.random().toString(36).slice(2,6),item:{...h,date:today()}})})
        .then(()=>toast(`${changed.length} rates badle`)).catch(()=>toast('Error','error')).finally(()=>{busy--;$('#bulkPct').value='';lastKey='';poll(true)});
      break}
    case 'rsave':publishReel();break;
    case 'rdel':if(confirm('Ye reel delete karein?'))removeItem('videos',el.dataset.id,'Reel delete ho gayi');break;
    case 'psave':saveProduct();break;
    case 'pclear':clearPF();break;
    case 'pedit':startEdit(el.dataset.id);break;
    case 'pdel':if(confirm('Ye product delete karein?'))removeItem('products',el.dataset.id,'Product delete ho gaya');break;
    case 'seed':seedSamples();break;
    case 'bsave':saveBanner();break;
    case 'bdel':if(confirm('Banner delete karein?'))removeItem('banners',el.dataset.id,'Banner delete ho gaya');break;
    case 'ssave':saveShop();break;
    case 'csave':saveConnect();break;
  }
});
document.addEventListener('change',e=>{
  const el=e.target,c=el.dataset.c;
  if(c==='tpl'){const t=BANNER_TPL[el.value];if(t){$('#bEn').value=t[0];$('#bHi').value=t[1]}return}
  if(c==='stock'){const p=(D.products||[]).find(x=>x.id===el.dataset.id);if(p)upsert('products',p.id,{...p,stock:el.checked});return}
  if(c==='show'){const p=(D.products||[]).find(x=>x.id===el.dataset.id);if(p)upsert('products',p.id,{...p,hidden:!el.checked});return}
  if(c==='fixedQty'){const p=(D.products||[]).find(x=>x.id===el.dataset.id);if(p)upsert('products',p.id,{...p,fixedQty:el.checked});return}
  if(c==='fixedWeight'){const p=(D.products||[]).find(x=>x.id===el.dataset.id);if(p)upsert('products',p.id,{...p,fixedWeight:+el.value},'Fixed weight saved');return}
  if(c==='ron'){const v=(D.videos||[]).find(x=>x.id===el.dataset.id);if(v)upsert('videos',v.id,{...v,on:el.checked});return}
  if(c==='bon'){const b=(D.banners||[]).find(x=>x.id===el.dataset.id);if(b)upsert('banners',b.id,{...b,on:el.checked});return}
  if(c==='rate'){const p=(D.products||[]).find(x=>x.id===el.dataset.id),v=+el.value;
    if(!p||!v){toast('Sahi rate daalein','error');renderPrices();return}
    if(v===p.rate)return;
    const from=p.rate;busy++;
    apiPost({action:'upsert',table:'products',id:p.id,item:{...p,rate:v}}).then(()=>apiPost({action:'upsert',table:'history',id:'h'+Date.now()+Math.random().toString(36).slice(2,6),item:{name:p.en,from,to:v,date:today()}})).then(()=>toast('Rate update ho gaya')).catch(()=>toast('Error','error')).finally(()=>{busy--;lastKey='';poll(true)});
    return}
  if(c==='ov'){const p=(D.products||[]).find(x=>x.id===el.dataset.id);if(!p)return;const ov={...(p.overrides||{})};if(el.value)ov[el.dataset.g]=+el.value;else delete ov[el.dataset.g];upsert('products',p.id,{...p,overrides:ov});return}
  if(el.id==='rFile'){rFileObj=el.files[0]||null;rPreviewUrl='';$('#rDropTxt').textContent=rFileObj?rFileObj.name:'Video chunein';reelPreview();return}
  if(el.id==='pfPhotoFile'){const f=el.files[0];if(!f)return;$('#pfPhotoTxt').textContent='Uploading photo…';
    uploadCloud(f,'image').then(m=>{$('#pfPhoto').value=m.url;$('#pfPhotoTxt').textContent='Photo upload ho gayi ✓'}).catch(err=>{$('#pfPhotoTxt').textContent='Photo upload nahi hua';toast(err.message,'error')});return}
  if(el.id==='pfFixedQty'){$('#pfFixedWeightWrap').style.display=el.checked?'block':'none';return}
  if(el.id==='bImgFile'){$('#bImgTxt').textContent=el.files[0]?el.files[0].name:'Banner image upload karein (optional)';return}
  if(el.id==='sFssaiFile'){const f=el.files[0];if(!f)return;$('#sFssaiTxt').textContent='Uploading…';
    uploadCloud(f,'image').then(m=>{$('#sFssaiImg').value=m.url;$('#sFssaiTxt').textContent='Certificate upload ho gayi ✓'}).catch(err=>{$('#sFssaiTxt').textContent='Upload nahi hua';toast(err.message,'error')});return}
});
document.addEventListener('input',e=>{
  if(e.target.id==='oq'){oq=e.target.value;renderOrders()}
  if(e.target.id==='rLink'){reelPreview()}
});

