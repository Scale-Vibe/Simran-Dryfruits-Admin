 {id:'p8',en:'Trail Mix',hi:'ट्रेल मिक्स',emoji:'🥣',cats:['Trail Mix'],tags:['Bestseller'],rate:750,bg:'#f3e7d3'},
 {id:'p9',en:'Healthy Combo',hi:'हेल्दी कॉम्बो',emoji:'🧺',cats:['Combo'],tags:['New'],rate:800,bg:'#efe9f5'},
 {id:'p10',en:'Diwali Gift Box',hi:'दिवाली गिफ्ट बॉक्स',emoji:'🎁',cats:['Gifting','Festive'],tags:[],rate:1100,bg:'#fbe6e3'}
];
