 {id:'p5',en:'Badi Elaichi',hi:'बड़ी इलायची',emoji:'🟤',cats:['Masala'],tags:[],rate:1800,bg:'#efe2d6'},
 {id:'p6',en:'Sonth (Dry Ginger)',hi:'सौंठ',emoji:'🫚',cats:['Masala'],tags:[],rate:450,bg:'#f3e6cf'},
