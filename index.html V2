  'New Year':['Happy New Year! Here is to healthy days','नव वर्ष की शुभकामनाएँ'],
  'Healthy choice':['Choose the right dry fruits for a healthier everyday','हर दिन सेहतमंद रहने के लिए सही ड्राई फ्रूट्स चुनें']
};
const SEED_PRODUCTS=[
 {id:'p1',en:'Almonds (Badam)',hi:'बादाम',emoji:'🌰',cats:['Festive','Gifting'],tags:['Bestseller'],rate:900,bg:'#f6ecd2'},
 {id:'p2',en:'Cashews (Kaju)',hi:'काजू',emoji:'🥜',cats:['Festive','Gifting'],tags:['Bestseller'],rate:850,bg:'#f7efdc'},
 {id:'p3',en:'Pumpkin Seeds',hi:'कद्दू के बीज',emoji:'🎃',cats:['Seeds'],tags:['New'],rate:700,bg:'#fde9cf'},
