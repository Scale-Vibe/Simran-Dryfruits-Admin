    </div>
    <div class="grid4" style="margin-top:12px;grid-template-columns:repeat(4,1fr);gap:8px">${WTS.map(w=>{const ov=(p.overrides||{})[w];return `<label class="sub" style="display:block">${wl(w)} · auto ${money(Math.round(p.rate*w/1000))}
      <input type="number" placeholder="${Math.round(p.rate*w/1000)}" value="${ov??''}" data-c="ov" data-id="${esc(p.id)}" data-g="${w}" style="margin-top:4px;padding:9px 10px"></label>`}).join('')}</div>
  </div>`).join(''):`<div class="empty"><i class="ri-price-tag-3-line"></i>Pehle products add karein.</div>`;
  const H=D.history||[];
  $('#pHist').innerHTML=H.length?H.slice(0,30).map(h=>`<div class="switchrow"><div>${esc(h.name)}<small>${esc(h.date)}</small></div><div>₹${h.from} → <b>₹${h.to}</b></div></div>`).join(''):'<div class="sub">Abhi koi rate change nahi hua.</div>';
}
function logHistory(name,from,to){return upsert('history','h'+Date.now()+Math.random().toString(36).slice(2,6),{name,from,to,date:today()})}

/* ===================== REELS ===================== */
let rFileObj=null,rPreviewUrl='';
function reelPreview(){
  const el=$('#rPrev'),link=$('#rLink').value.trim();
  if(rFileObj){
    if(!rPreviewUrl){try{rPreviewUrl=URL.createObjectURL(rFileObj)}catch(e){rPreviewUrl=''}}
    el.hidden=false;el.innerHTML=`${rPreviewUrl?`<video src="${rPreviewUrl}" muted playsinline controls></video>`:''}<div><b>${esc(rFileObj.name)}</b><div class="sub">${(rFileObj.size/1048576).toFixed(1)} MB · upload hone par publish hogi</div></div>`;
  }else if(link){
    const id=ytId(link);
    el.hidden=false;el.innerHTML=(id?`<img src="https://img.youtube.com/vi/${id}/hqdefault.jpg" alt="">`:'')+`<div><b>${kindOf({url:link})}</b><div class="sub">${/^https:\/\//.test(link)?'Link theek lag raha hai':'Link https:// se shuru honi chahiye'}</div></div>`;
  }else{el.hidden=true;el.innerHTML=''}
}
function clearReelForm(){
  rFileObj=null;rPreviewUrl='';$('#rFile').value='';$('#rDropTxt').textContent='Video chunein (MP4, MOV, WebM — max 100 MB)';
  ['rLink','rEn','rHi'].forEach(i=>$('#'+i).value='');reelPreview();
}
async function uploadCloud(file,kind){
  const c=cfg();
  if(!c.cloud||!c.preset)throw new Error('Connect page par Cloudinary cloud name aur preset daalein');
  if(kind==='video'&&file.size>100*1048576)throw new Error('Video 100 MB se chhoti honi chahiye');
  const fd=new FormData();fd.append('file',file);fd.append('upload_preset',c.preset);
  const r=await fetch(`https://api.cloudinary.com/v1_1/${encodeURIComponent(c.cloud)}/${kind}/upload`,{method:'POST',body:fd});
  const j=await r.json();
  if(!r.ok||!j.secure_url)throw new Error((j.error&&j.error.message)||'Upload fail hua');
  return {url:j.secure_url,thumb:kind==='video'?j.secure_url.replace(/\.[a-z0-9]+$/i,'.jpg'):j.secure_url};
}
async function publishReel(){
  const en=$('#rEn').value.trim(),link=$('#rLink').value.trim();
  if(!connected())return toast('Pehle Connect karein','error');
  if(!en)return toast('Title likhein','error');
  if(!rFileObj&&!link)return toast('Video chunein ya link paste karein','error');
  const btn=$('#rBtn');btn.disabled=true;
  try{
    let media;
    if(rFileObj){
      btn.textContent='Uploading…';
      media=await uploadCloud(rFileObj,'video');
    }else{
      if(!/^https:\/\//.test(link))throw new Error('Link https:// se shuru honi chahiye');
      const id=ytId(link);
      media={url:link,thumb:id?`https://img.youtube.com/vi/${id}/hqdefault.jpg`:''};
    }
    btn.textContent='Publishing…';
    const id='v'+Date.now();
    await upsert('videos',id,{en,hi:$('#rHi').value.trim()||en,url:media.url,thumb:media.thumb,kind:rFileObj?'video':'link',pid:$('#rPid').value,w:+$('#rW').value,on:$('#rOn').checked,created:new Date().toISOString()},'Reel publish ho gayi');
    clearReelForm();
  }catch(e){toast(e.message,'error')}
  finally{btn.disabled=false;btn.textContent='Publish reel'}
}
function renderReels(){
  const P=D.products||[],sel=$('#rPid'),cur=sel.value;
  sel.innerHTML=P.map(p=>`<option value="${esc(p.id)}">${esc(p.en)}</option>`).join('');
  if(cur&&P.some(p=>p.id===cur))sel.value=cur;
  const V=D.videos||[];
  $('#rList').innerHTML=V.length?V.map(v=>{const p=P.find(x=>x.id===v.pid),id=ytId(v.url);
    const thumb=v.thumb?`<img class="thumb vid" src="${esc(v.thumb)}" alt="" style="object-fit:cover">`:id?`<img class="thumb vid" src="https://img.youtube.com/vi/${id}/hqdefault.jpg" alt="">`:`<div class="thumb vid">▶</div>`;
    return `<div class="item"><div class="prod">${thumb}<div style="flex:1;min-width:0"><div class="name">${esc(v.en)}</div><div class="sub">${esc(v.hi||'')}</div><div class="sub">${kindOf(v)} · ${p?esc(p.en):'product nahi'} · ${wl(v.w||100)}</div></div></div>
      <div class="switchrow" style="margin-top:6px"><div>${v.on!==false?'<span class="pill on">Live</span>':'<span class="pill off">Hidden</span>'}</div>
        <label class="sw"><input type="checkbox" data-c="ron" data-id="${esc(v.id)}" ${v.on!==false?'checked':''}><span></span></label></div>
      <div style="text-align:right"><button class="link" data-a="rdel" data-id="${esc(v.id)}">Delete</button></div></div>`}).join(''):`<div class="empty"><i class="ri-movie-2-line"></i>Abhi koi reel nahi. Upar se pehla video upload karein.</div>`;
}

/* ===================== PRODUCTS ===================== */
function renderProducts(){
  const P=D.products||[];
  $('#pmList').innerHTML=P.length?P.map(p=>`<div class="item"><div class="prod">
      ${p.photo?`<img class="thumb" src="${esc(cdn(p.photo))}" alt="">`:`<div class="thumb" style="background:${esc(p.bg||'#eee')}">${esc(p.emoji||'🥜')}</div>`}
      <div style="flex:1;min-width:0"><div class="name">${esc(p.en)} ${p.hidden?'<span class="pill off">hidden</span>':''}</div>
      <div class="sub">${esc(p.hi||'')} · ${(p.cats||[]).map(esc).join(', ')||'category nahi'}</div><div class="sub">${money(p.rate)} per kg</div></div></div>
    <div class="acts" style="margin-top:10px"><button class="btn sm ghost" data-a="pedit" data-id="${esc(p.id)}">Edit</button><button class="link" data-a="pdel" data-id="${esc(p.id)}">Delete</button></div></div>`).join('')
    :`<div class="empty"><i class="ri-shopping-bag-3-line"></i>Abhi koi product nahi.</div>`;
  $('#seedBox').innerHTML=P.length?'':`<div class="notice info">Shuruaat ke liye sample products load kar sakte hain.<button class="btn sm" data-a="seed">Load samples</button></div>`;
