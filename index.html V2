/* ===================== HELPERS ===================== */
const $=s=>document.querySelector(s);
const $$=s=>[...document.querySelectorAll(s)];
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const money=n=>'₹'+Number(n||0).toLocaleString('en-IN');
const wl=g=>g>=1000?(g/1000)+'kg':g+'g';
const today=()=>new Date().toLocaleDateString('en-IN');
const cdn=u=>String(u||'').replace('/image/upload/','/image/upload/f_auto,q_auto,w_200/');
const ytId=u=>{const m=String(u||'').match(/(?:youtube\.com\/(?:shorts\/|watch\?v=|embed\/)|youtu\.be\/)([\w-]{11})/);return m?m[1]:''};
const kindOf=v=>v.kind==='video'||/res\.cloudinary\.com\/.*\/video\//.test(v.url||'')?'Video':ytId(v.url)?'YouTube Short':/instagram\.com/.test(v.url||'')?'Instagram':'Link';
const stockOff=p=>p.stock===false;
function load(k,d){try{const v=JSON.parse(localStorage.getItem(k));return v??d}catch(e){return d}}
function save(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}
function toast(msg,type){
  const box=$('#toasts'),el=document.createElement('div');
  el.className='toast '+(type||'');
  el.innerHTML=`<i class="${type==='error'?'ri-error-warning-fill':'ri-check-line'}"></i><span>${esc(msg)}</span>`;
  box.appendChild(el);
  setTimeout(()=>{el.style.opacity='0';setTimeout(()=>el.remove(),300)},2800);
}
function alarm(){try{const C=window.AudioContext||window.webkitAudioContext,a=new C(),o=a.createOscillator();o.connect(a.destination);o.frequency.value=720;o.start();o.stop(a.currentTime+.5)}catch(e){}try{navigator.vibrate&&navigator.vibrate([300,120,300])}catch(e){}}

/* ===================== BACKEND ===================== */
async function apiGet(params){const r=await fetch(cfg().url+'?'+new URLSearchParams(Object.assign({token:cfg().token},params)));return r.json()}
async function apiPost(body){const r=await fetch(cfg().url,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(Object.assign({token:cfg().token},body))});return r.json()}

/* ===================== STATE ===================== */
let D={shop:{},products:[],banners:[],videos:[],orders:[],history:[]};
let page='home',mpage='products',ofilter='all',oq='',busy=0,lastKey='',booted=false,seen=new Set(),editId=null;
let liveState='idle';

function setLive(s){
  liveState=s;
  const el=$('#live');el.className='live '+(s==='ok'?'ok':s==='err'?'err':'');
  $('#liveTxt').textContent=s==='ok'?'Live':s==='err'?'Offline':'Connect';
  $('#setupBar').hidden=connected();
}

/* Silent 5-second refresh: data change hone par hi list dobara banti hai */
async function poll(force){
  if(!connected()){setLive('idle');return}
  if(busy&&!force)return;
  try{
    const j=await apiGet({action:'all',token:cfg().token});
    if(!j.ok)throw new Error(j.error||'error');
    setLive('ok');
    const key=JSON.stringify(j.data);
    if(key===lastKey)return;
    lastKey=key;
    D=j.data;
    const fresh=(D.orders||[]).filter(o=>!seen.has(o.code||o.id));
    (D.orders||[]).forEach(o=>seen.add(o.code||o.id));
    if(booted&&fresh.length){alarm();toast(`Naya order ${fresh[0].code||fresh[0].id} · ${money(fresh[0].total)}`)}
    booted=true;
    renderPage();
  }catch(e){setLive('err')}
}
async function mutate(body,msg){
  busy++;
  try{
    const j=await apiPost(body);
    if(!j.ok)throw new Error(j.error||'Save nahi hua');
    if(msg)toast(msg);
  }catch(e){toast('Error: '+e.message,'error')}
  finally{busy--;lastKey='';await poll(true)}
}
const upsert=(table,id,item,msg)=>mutate({action:'upsert',table,id,item},msg);
const removeItem=(table,id,msg)=>mutate({action:'remove',table,id},msg);

/* ===================== NAVIGATION ===================== */
function nav(v,m){
  page=v;
  if(m)mpage=m;
  $$('[data-page]').forEach(s=>s.hidden=s.dataset.page!==v);
  $$('.nav button').forEach(b=>b.classList.toggle('on',b.dataset.v===v));
  if(v==='more'){showMtab(mpage)}
  if(v==='more'&&mpage==='shop')fillShop();
  if(v==='more'&&mpage==='connect')fillConnect();
  renderPage();
  window.scrollTo({top:0,behavior:'smooth'});
}
function showMtab(m){
  mpage=m;
  $$('[data-m]').forEach(s=>s.hidden=s.dataset.m!==m);
  $$('[data-a="mtab"]').forEach(b=>b.classList.toggle('on',b.dataset.v===m));
  if(m==='shop')fillShop();
  if(m==='connect')fillConnect();
  renderPage();
}
function renderPage(){
  const newN=(D.orders||[]).filter(o=>o.status==='placed').length;
  const nb=$('#navNew');nb.hidden=!newN;nb.textContent=newN;
  if(page==='home')renderHome();
  if(page==='orders')renderOrders();
  if(page==='stock')renderStock();
  if(page==='prices')renderPrices();
  if(page==='reels')renderReels();
  if(page==='more'){
    if(mpage==='products')renderProducts();
    if(mpage==='banners')renderBanners();
  }
}

/* ===================== HOME ===================== */
function renderHome(){
  const td=new Date().toDateString(),O=D.orders||[];
  const sales=O.filter(o=>o.status!=='cancelled'&&o.placed&&new Date(o.placed).toDateString()===td).reduce((a,o)=>a+Number(o.total||0),0);
  $('#hSales').textContent=money(sales);
  const nw=O.filter(o=>o.status==='placed').length,pr=O.filter(o=>['confirmed','packed'].includes(o.status)).length,rd=O.filter(o=>o.status==='ready').length;
  const low=(D.products||[]).filter(p=>stockOff(p)||Object.values(p.stockW||{}).includes(false)).length;
  $('#hNew').textContent=nw?`(${nw})`:'';
  $('#hStats').innerHTML=`<div class="stat"><small>Naye orders</small><b>${nw}</b></div>
    <div class="stat"><small>Ban rahe hain</small><b>${pr}</b></div>
    <div class="stat"><small>Pickup ke liye ready</small><b>${rd}</b></div>
    <div class="stat ${low?'warn':''}"><small>Stock alert</small><b>${low}</b></div>`;
  const recent=O.slice(0,4);
  $('#hRecent').innerHTML=recent.length?recent.map(orderCard).join(''):`<div class="empty"><i class="ri-inbox-line"></i>Abhi koi order nahi. Customer order karega to yahan dikhega.</div>`;
}

/* ===================== ORDERS ===================== */
const FILTERS=[['all','All'],['placed','New'],['active','Preparing'],['ready','Ready'],['collected','Collected'],['cancelled','Cancelled']];
function passes(f,o){
  if(f==='all')return true;
  if(f==='active')return ['confirmed','packed'].includes(o.status);
  return o.status===f;
}
function renderOrders(){
  const O=D.orders||[];
  $('#oFilters').innerHTML=FILTERS.map(([k,l])=>`<button class="${ofilter===k?'on':''}" data-a="ofilter" data-f="${k}">${l}<b>${O.filter(o=>passes(k,o)).length}</b></button>`).join('');
  const q=oq.trim().toLowerCase();
  const L=O.filter(o=>passes(ofilter,o)&&(!q||String(o.code||o.id).toLowerCase().includes(q)||String(o.phone).includes(q)));
  $('#oList').innerHTML=L.length?L.map(orderCard).join(''):`<div class="empty"><i class="ri-inbox-line"></i>${O.length?'Is filter mein koi order nahi.':'Abhi koi order nahi.'}</div>`;
}
function orderCard(o){
  const cur=o.status||'placed',idx=FLOW.indexOf(cur),closed=cur==='collected'||cur==='cancelled';
  const code=o.code||o.id||'';
  const phone=String(o.phone||'');
  const wa=`https://wa.me/91${phone}?text=${encodeURIComponent(`Your order ${code} is ready for pickup at SIMRAN DRYFRUITS & Daily Needs. Thank you!`)}`;
  const time=o.placed?new Date(o.placed).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}):'';
  const action=!closed&&NEXT[cur]?`<div class="acts">
      <button class="btn" data-a="ostatus" data-code="${esc(code)}" data-s="${NEXT[cur][0]}">${NEXT[cur][1]}</button>
      <button class="btn warn" data-a="ostatus" data-code="${esc(code)}" data-s="cancelled">Cancel</button></div>`:'';
  return `<article class="order ${esc(cur)}">
    <div class="o-top">
      <div><div class="o-code">${esc(code)}</div><div class="sub">${time} · pickup ${esc(o.slot||'')}</div></div>
      <span class="pill ${esc(cur)}">${SLBL[cur]||esc(cur)}</span>
    </div>
    ${cur!=='cancelled'?`<div class="prog"><i style="width:${Math.max(idx,0)/4*100}%"></i></div>`:''}
    <div class="cust">
      <div><b>${esc(o.name)}</b><div class="sub">${esc(phone)}</div></div>
      <div class="ibs">
        <a class="ib" href="tel:${esc(phone)}" aria-label="Call"><i class="ri-phone-line"></i></a>
        <a class="ib wa" href="${wa}" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="ri-whatsapp-line"></i></a>
        <button class="ib" data-a="print" data-code="${esc(code)}" aria-label="Bill"><i class="ri-printer-line"></i></button>
      </div>
    </div>
    <ul class="lines">${(o.items||[]).map(i=>`<li><span>${esc(i.name)} ${wl(i.g)} × ${i.q}</span><span>${money(i.amt)}</span></li>`).join('')}</ul>
    ${o.note?`<p class="note">📝 ${esc(o.note)}</p>`:''}
    <div class="tot"><span class="sub">Total · pay at shop</span><b>${money(o.total)}</b></div>
    ${action}
  </article>`;
}
function setOrderStatus(code,st){
  const o=(D.orders||[]).find(x=>(x.code===code||x.id===code));if(!o)return;
  const id=o.id||o.code||code;
  upsert('orders',id,{...o,id,code:o.code||id,status:st,updated:new Date().toISOString()},`${code}: ${SLBL[st]||st}`);
}
function printBill(code){
  const o=(D.orders||[]).find(x=>(x.code===code||x.id===code));if(!o)return;
  $('#printArea').innerHTML=`<h3>SIMRAN DRYFRUITS &amp; Daily Needs</h3><div>Order ${esc(o.code||o.id)}</div><div>${esc(o.name)} · ${esc(o.phone)}</div><div>Pickup: ${esc(o.slot)}</div><hr>
    ${(o.items||[]).map(i=>`<div>${esc(i.name)} ${wl(i.g)} x${i.q} = ${money(i.amt)}</div>`).join('')}<hr><b>TOTAL ${money(o.total)}</b><div>Takeaway · Pay at shop</div>`;
  window.print();
}

/* ===================== STOCK ===================== */
function renderStock(){
  const P=D.products||[],out=P.filter(stockOff).length;
  $('#sSummary').innerHTML=`<div class="notice ${out?'warn':'info'}">${out?`${out} product out of stock`:'Sab items stock mein hain'}</div>`;
  $('#sList').innerHTML=P.length?P.map(p=>`<div class="item">
    <div class="prod">${p.photo?`<img class="thumb" src="${esc(cdn(p.photo))}" alt="">`:`<div class="thumb" style="background:${esc(p.bg||'#eee')}">${esc(p.emoji||'🥜')}</div>`}
