<script>
/* ===================== CONFIG ===================== */
const CFG_KEY='sd_admin_cfg';
const cfg=()=>Object.assign({url:'',token:'',cloud:'',preset:''},load(CFG_KEY,{}));
const isUrl=u=>/^https:\/\/script\.google\.com\//.test(u||'');
const connected=()=>isUrl(cfg().url)&&!!cfg().token;
const WTS=[50,100,125,250];
const CATS=['Festive','Gifting','Seeds','Combo','Trail Mix','Masala','Daily Needs'];
const FLOW=['placed','confirmed','packed','ready','collected'];
const SLBL={placed:'New',confirmed:'Confirmed',packed:'Packed',ready:'Ready for pickup',collected:'Collected',cancelled:'Cancelled'};
const NEXT={placed:['confirmed','Confirm order'],confirmed:['packed','Mark as packed'],packed:['ready','Mark ready for pickup'],ready:['collected','Mark as collected']};
const BANNER_TPL={
